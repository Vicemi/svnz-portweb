---
import SvnzGameView from '../components/SvnzGame.tsx';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Super Vampire Ninja Zero</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <SvnzGameView client:only="react" />
  </body>
</html>

<style is:global>
  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; overscroll-behavior: none; }
  .sv-stage { position: fixed; inset: 0; height: 100vh; height: 100dvh; background: #000; }
  .sv-canvas { display: block; width: 100%; height: 100%; outline: none; touch-action: none; }
  .sv-rotate { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.92); color: #f0e0e0; z-index: 10; text-align: center; }
  .sv-rotate-inner { font: bold 1.4rem/1.5 system-ui, sans-serif; display: flex; flex-direction: column; gap: 1rem; }
  .sv-rotate-icon { font-size: 3rem; animation: sv-spin 2s ease-in-out infinite; }
  @keyframes sv-spin { 0%, 20% { transform: rotate(0deg); } 70%, 100% { transform: rotate(90deg); } }

  .sv-touch { position: fixed; inset: 0; z-index: 5; touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent; }
  .sv-stick-ring, .sv-stick-knob { position: absolute; border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; }
  .sv-stick-ring { width: 124px; height: 124px; border: 2px solid rgba(255,255,255,0.45); background: rgba(255,255,255,0.08); }
  .sv-stick-knob { width: 58px; height: 58px; background: rgba(255,255,255,0.35); border: 2px solid rgba(255,255,255,0.7); }
  .sv-stick-hint { position: absolute; pointer-events: none; border-radius: 50%; left: calc(1.2rem + env(safe-area-inset-left)); bottom: calc(1.2rem + env(safe-area-inset-bottom));
    width: 7rem; height: 7rem; display: flex; align-items: center; justify-content: center; border: 2px dashed rgba(255,255,255,0.22); color: rgba(255,255,255,0.4); font: bold 2rem system-ui; }
  .sv-act { position: absolute; pointer-events: none; border-radius: 50%; width: 3.9rem; height: 3.9rem; display: flex; flex-direction: column; align-items: center; justify-content: center;
    border: 2px solid rgba(255,255,255,0.55); background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.95); text-shadow: 0 1px 2px rgba(0,0,0,0.8); transition: transform 60ms, background 60ms; }
  .sv-act.is-down { background: rgba(255,255,255,0.4); transform: scale(0.93); }
  .sv-act-k { font: bold 1.05rem system-ui, sans-serif; line-height: 1; }
  .sv-act-s { font: 600 0.55rem system-ui, sans-serif; opacity: 0.85; }
  /* right cluster, keyboard shape: bottom row Q W E, upper row A S D */
  .sv-b-fast    { right: calc(10.2rem + env(safe-area-inset-right)); bottom: calc(1rem + env(safe-area-inset-bottom)); border-color: rgba(255,210,120,0.8); }
  .sv-b-strong  { right: calc(5.6rem + env(safe-area-inset-right));  bottom: calc(1rem + env(safe-area-inset-bottom)); border-color: rgba(255,120,120,0.8); }
  .sv-b-jump    { right: calc(1rem + env(safe-area-inset-right));    bottom: calc(1rem + env(safe-area-inset-bottom)); border-color: rgba(140,220,255,0.8); }
  .sv-b-special { right: calc(10.2rem + env(safe-area-inset-right)); bottom: calc(5.6rem + env(safe-area-inset-bottom)); border-color: rgba(220,140,255,0.8); }
  .sv-b-defense { right: calc(5.6rem + env(safe-area-inset-right));  bottom: calc(5.6rem + env(safe-area-inset-bottom)); border-color: rgba(160,255,160,0.8); }
  .sv-b-dash    { right: calc(1rem + env(safe-area-inset-right));    bottom: calc(5.6rem + env(safe-area-inset-bottom)); border-color: rgba(255,255,160,0.8); }
  .sv-top-btn { position: fixed; z-index: 8; top: calc(0.6rem + env(safe-area-inset-top)); right: calc(0.6rem + env(safe-area-inset-right)); width: 3rem; height: 3rem; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; border: 2px solid rgba(255,255,255,0.6); background: rgba(0,0,0,0.35); color: #fff; font: bold 1.1rem system-ui; padding: 0;
    touch-action: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .sv-help-btn { right: calc(4.2rem + env(safe-area-inset-right)); }
  @media (max-height: 420px) {
    .sv-act { width: 3.3rem; height: 3.3rem; }
    .sv-b-fast { right: calc(8.6rem + env(safe-area-inset-right)); }
    .sv-b-strong { right: calc(4.8rem + env(safe-area-inset-right)); }
    .sv-b-special { right: calc(8.6rem + env(safe-area-inset-right)); bottom: calc(4.8rem + env(safe-area-inset-bottom)); }
    .sv-b-defense { right: calc(4.8rem + env(safe-area-inset-right)); bottom: calc(4.8rem + env(safe-area-inset-bottom)); }
    .sv-b-dash { bottom: calc(4.8rem + env(safe-area-inset-bottom)); }
  }
</style>
