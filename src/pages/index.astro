---
import SvnzGameView from '../components/SvnzGame.tsx';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Super Vampire Ninja Zero</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <SvnzGameView client:only="react" />
  </body>
</html>

<style is:global>
  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; overscroll-behavior: none; }
  .sv-stage { position: fixed; inset: 0; height: 100vh; height: 100dvh; background: #000; }
  .sv-stage:fullscreen { width: 100vw; height: 100vh; }
  .sv-canvas { display: block; width: 100%; height: 100%; outline: none; touch-action: none; }
  .sv-rotate { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.92); color: #f0e0e0; z-index: 10; text-align: center; }
  .sv-rotate-inner { font: bold 1.4rem/1.5 system-ui, sans-serif; display: flex; flex-direction: column; gap: 1rem; }
  .sv-rotate-icon { font-size: 3rem; animation: sv-spin 2s ease-in-out infinite; }
  @keyframes sv-spin { 0%, 20% { transform: rotate(0deg); } 70%, 100% { transform: rotate(90deg); } }

  /* --- touch controls: everything scales with the screen height so phones of any size keep a playable layout ---
     --b = diameter of an action button; --g = gap; --m = margin to the screen edge (notch aware) */
  .sv-touch { --b: clamp(2.9rem, 17vh, 4.6rem); --g: clamp(0.35rem, 2vh, 0.7rem); --m: clamp(0.5rem, 3vh, 1.2rem);
    position: fixed; inset: 0; z-index: 5; touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent; }
  .sv-stick-ring, .sv-stick-knob { position: absolute; border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; }
  .sv-stick-ring { width: calc(var(--b) * 2.2); height: calc(var(--b) * 2.2); border: 2px solid rgba(255,255,255,0.45); background: rgba(255,255,255,0.08); }
  .sv-stick-knob { width: calc(var(--b) * 1.05); height: calc(var(--b) * 1.05); background: rgba(255,255,255,0.35); border: 2px solid rgba(255,255,255,0.7); }
  .sv-stick-hint { position: absolute; pointer-events: none; border-radius: 50%; left: calc(var(--m) + env(safe-area-inset-left)); bottom: calc(var(--m) + env(safe-area-inset-bottom));
    width: calc(var(--b) * 2.1); height: calc(var(--b) * 2.1); display: flex; align-items: center; justify-content: center; border: 2px dashed rgba(255,255,255,0.22); color: rgba(255,255,255,0.4); font: bold 2rem system-ui; }
  .sv-act { position: absolute; pointer-events: none; border-radius: 50%; width: var(--b); height: var(--b); display: flex; flex-direction: column; align-items: center; justify-content: center;
    border: 2px solid rgba(255,255,255,0.55); background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.95); text-shadow: 0 1px 2px rgba(0,0,0,0.8); transition: transform 60ms, background 60ms; }
  .sv-act.is-down { background: rgba(255,255,255,0.4); transform: scale(0.93); }
  .sv-act-k { font: bold clamp(0.5rem, 2.5vh, 0.78rem) system-ui, sans-serif; line-height: 1.1; text-align: center; padding: 0 0.15rem; }
  .sv-act-s { font: 700 clamp(0.45rem, 1.8vh, 0.62rem) system-ui, sans-serif; opacity: 0.7; }
  /* always-visible buttons: back and help top right, fullscreen top left */
  .sv-top-btn { position: fixed; z-index: 8; top: calc(0.5rem + env(safe-area-inset-top)); right: calc(0.6rem + env(safe-area-inset-right)); width: clamp(2.4rem, 10vh, 3rem); height: clamp(2.4rem, 10vh, 3rem); border-radius: 50%;
    display: flex; align-items: center; justify-content: center; border: 2px solid rgba(255,255,255,0.6); background: rgba(0,0,0,0.35); color: #fff; font: bold 1.1rem system-ui; padding: 0;
    touch-action: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .sv-top-btn:active { background: rgba(255,255,255,0.3); transform: scale(0.94); }
  .sv-help-btn { right: calc(0.6rem + clamp(2.4rem, 10vh, 3rem) + 0.5rem + env(safe-area-inset-right)); }
  .sv-full-btn { left: calc(0.6rem + env(safe-area-inset-left)); right: auto; }



  /* --- VS y Online panels: the look of the game's own menu (dark panels, blue dashed frames, the brown / gold selection bar, the red title glow,
        8-bit text) --- */
  .ol-overlay { --blue: #3a63ff; --blue-d: #1a2c88; --ink: #05071a; --gold: #f0b030; --brown: #7a3410; --brown-l: #b8601c; --red: #ff2a24;
    position: fixed; inset: 0; z-index: 30; display: flex; justify-content: center; padding: 0.6rem; overflow: auto; color: #e8ecff;
    background: radial-gradient(ellipse at 50% 30%, rgba(8, 18, 60, 0.88), rgba(0, 0, 0, 0.94)); font: 400 8px/1.9 'Press Start 2P', monospace; letter-spacing: 0.02em; }
  .ol-overlay * { box-sizing: border-box; }
  .ol-card { width: min(60rem, 100%); height: fit-content; margin: auto; padding: 1rem 1.2rem; background: rgba(2, 4, 22, 0.94); border: 2px solid var(--blue);
    box-shadow: 0 0 0 2px #000, 0 0 0 4px var(--blue-d), 0 14px 40px rgba(0, 0, 0, 0.8); image-rendering: pixelated; }
  .ol-card.narrow { width: min(27rem, 100%); }
  .ol-card h1 { margin: 0 0 0.6rem; font: 400 14px/1.5 'Press Start 2P', monospace; color: var(--red); text-shadow: 0 0 6px #ff0000, 2px 2px 0 #000; }
  .ol-card h2 { font: 400 10px 'Press Start 2P', monospace; color: var(--gold); }
  .ol-sub { margin: 0.2rem 0 0.9rem; color: #aab4e8; }
  .ol-label { margin: 0.5rem 0 0.35rem; color: var(--gold); text-shadow: 1px 1px 0 #000; }
  .ol-two { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .ol-chars { display: grid; grid-template-columns: repeat(auto-fill, minmax(5.2rem, 1fr)); gap: 0.35rem; }
  .ol-char, .ol-var, .ol-btn, .ol-item { color: #cfd8ff; background: #05071a; border: 2px dashed var(--blue-d); border-radius: 0; cursor: pointer; font-family: inherit; }
  .ol-char { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; padding: 0.3rem 0.1rem; font-size: 7px; line-height: 1.5; }
  .ol-char:hover:not(:disabled), .ol-char:focus-visible, .ol-var:hover:not(:disabled), .ol-var:focus-visible, .ol-btn:hover:not(:disabled), .ol-btn:focus-visible, .ol-item:hover:not(:disabled) { border-color: var(--blue); border-style: solid; outline: none; color: #fff; }
  .ol-char.on, .ol-var.on, .ol-btn.on, .ol-item.on, .ol-btn.primary { background: linear-gradient(#a85414, var(--brown)); border: 2px solid var(--gold); color: #fff; text-shadow: 1px 1px 0 #000; }
  .ol-char:disabled, .ol-var:disabled { opacity: 0.35; cursor: not-allowed; }
  .ol-portrait { image-rendering: pixelated; display: block; }
  .ol-variants { display: flex; gap: 0.35rem; align-items: center; flex-wrap: wrap; }
  .ol-var { position: relative; padding: 0.15rem; }
  .ol-var em { position: absolute; left: 0; right: 0; bottom: 0; font: 400 6px/1.3 'Press Start 2P', monospace; font-style: normal; background: rgba(0, 0, 0, 0.75); color: #ff9a9a; text-align: center; }
  .ol-note { color: #7d86c0; font-size: 7px; }
  .ol-info { margin-top: 0.6rem; min-height: 5.6rem; color: #aab4e8; font-size: 8px; line-height: 1.9; }
  .ol-info b { color: var(--gold); }
  .ol-info ul { margin: 0.3rem 0 0; padding-left: 1.1rem; }
  .ol-keys { margin: 0.8rem 0; padding: 0.6rem 0.7rem; background: #00020e; border: 2px dashed var(--blue-d); display: grid; gap: 0.35rem; font-size: 7px; line-height: 1.7; }
  .ol-actions { display: flex; gap: 0.6rem; justify-content: flex-end; margin-top: 1rem; flex-wrap: wrap; }
  .ol-btn { padding: 0.7rem 1rem; font-size: 9px; }
  .ol-btn.primary.on { background: linear-gradient(#2fae56, #14602c); border-color: #9dffb4; }
  .ol-btn.small { padding: 0.4rem 0.6rem; font-size: 8px; }
  .ol-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .ol-field { display: block; margin: 0.7rem 0; color: var(--gold); }
  .ol-field input { display: block; width: 100%; margin-top: 0.45rem; padding: 0.6rem 0.7rem; background: #00020e; color: #fff; border: 2px solid var(--blue-d); border-radius: 0; font: 400 10px 'Press Start 2P', monospace; }
  .ol-field input:focus { outline: none; border-color: var(--gold); }
  .ol-code-in { font-size: 18px !important; letter-spacing: 0.3em; text-align: center; text-transform: uppercase; }
  .ol-error { margin: 0.6rem 0; padding: 0.6rem 0.7rem; background: #2a0508; border: 2px solid #ff3a3a; color: #ffc8c8; }
  .ol-result { margin: 0.6rem 0; padding: 0.6rem 0.7rem; background: #062412; border: 2px solid #3edc7a; color: #c4ffd8; }
  .ol-head { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; flex-wrap: wrap; }
  .ol-code { font: 400 28px 'Press Start 2P', monospace; letter-spacing: 0.25em; color: #fff; background: #00020e; border: 2px dashed var(--gold); padding: 0.6rem 0.9rem; display: inline-block; user-select: all; text-shadow: 3px 3px 0 var(--brown); }
  .ol-copy { display: flex; gap: 0.4rem; margin-top: 0.5rem; }
  .ol-meta { text-align: right; display: grid; gap: 0.4rem; color: #aab4e8; }
  .ol-mode { display: flex; gap: 0.3rem; justify-content: flex-end; }
  .ol-slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(9.6rem, 1fr)); gap: 0.4rem; margin: 0.9rem 0; }
  .ol-slot { position: relative; display: flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.5rem; background: rgba(5, 7, 26, 0.9); border: 2px solid var(--blue-d); border-top-width: 4px; min-height: 4.4rem; }
  .ol-slot.me { background: rgba(26, 44, 136, 0.35); }
  .ol-slot.empty { min-height: 3.2rem; justify-content: center; color: #4c5590; border-style: dashed; }
  .ol-slot.off { opacity: 0.6; }
  .ol-slot-t { display: grid; gap: 0.2rem; flex: 1; min-width: 0; font-size: 7px; }
  .ol-slot-t b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #fff; font-weight: 400; font-size: 8px; }
  .ol-slot-t span { color: #8f9ad8; }
  .ol-lost { color: var(--gold) !important; }
  .ol-ok { position: absolute; right: 6px; bottom: 4px; color: #4c5590; font-size: 7px; } .ol-ok.on { color: #5bff8a; }
  .ol-kick { position: absolute; top: 0; right: 2px; background: none; border: 0; color: #ff8a8a; font: 400 9px 'Press Start 2P', monospace; cursor: pointer; padding: 0.15rem 0.3rem; }
  .ol-teams { display: flex; gap: 0.4rem; align-items: center; margin-top: 0.7rem; flex-wrap: wrap; }
  .ol-diff { margin-top: 0.8rem; padding: 0.6rem; background: #00020e; border: 2px dashed var(--blue-d); color: #aab4e8; font-size: 7px; line-height: 1.8; }
  .ol-setup pre { background: #00020e; padding: 0.7rem; overflow: auto; font-size: 8px; border: 2px dashed var(--blue-d); }
  .ol-setup code { color: var(--gold); }
  .ol-settings { margin-top: 0.9rem; padding: 0.7rem; background: #00020e; border: 2px dashed var(--blue-d); }
  .ol-switch { display: flex; align-items: center; gap: 0.6rem; margin: 0.3rem 0 0.7rem; cursor: pointer; }
  .ol-switch input { width: 14px; height: 14px; accent-color: var(--gold); }
  .ol-items { display: grid; grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr)); gap: 0.4rem; }
  .ol-items.off { opacity: 0.4; }
  .ol-item { display: grid; grid-template-columns: auto 1fr; grid-template-areas: 'i n' 'i b'; gap: 0.1rem 0.6rem; align-items: center; text-align: left; padding: 0.4rem 0.5rem; opacity: 0.55; font-size: 7px; line-height: 1.6; }
  .ol-item .ol-ico { grid-area: i; } .ol-item b { grid-area: n; font-size: 8px; font-weight: 400; } .ol-item small { grid-area: b; color: #aab4e8; font-size: 6px; line-height: 1.7; }
  .ol-item.on { opacity: 1; background: linear-gradient(#3a1d0a, #231008); }
  .ol-item:disabled { cursor: default; }
  .ol-ico { display: inline-block; background-image: url('/assets/bonus/powerups.png'); image-rendering: pixelated; background-repeat: no-repeat; flex: none; }
  @media (max-width: 40rem) { .ol-two { grid-template-columns: 1fr; } .ol-card { padding: 0.8rem; } .ol-code { font-size: 20px; } }

  /* the buttons of the character, packed toward the bottom-right corner (first = the main one under the thumb) */
  .sv-slot-0, .sv-slot-2 { right: calc(var(--m) + env(safe-area-inset-right)); }
  .sv-slot-1, .sv-slot-3 { right: calc(var(--m) + (var(--b) + var(--g)) + env(safe-area-inset-right)); }
  .sv-slot-4, .sv-slot-5 { right: calc(var(--m) + (var(--b) + var(--g)) * 2 + env(safe-area-inset-right)); }
  .sv-slot-0, .sv-slot-1, .sv-slot-4 { bottom: calc(var(--m) + env(safe-area-inset-bottom)); }
  .sv-slot-2, .sv-slot-3, .sv-slot-5 { bottom: calc(var(--m) + var(--b) + var(--g) + env(safe-area-inset-bottom)); }

  /* thin scrollbars in the game's colors (lobby, selector, level of detail panels) */
  .ol-overlay, .ol-card, .ol-info, .ol-keys, .ol-setup pre { scrollbar-width: thin; scrollbar-color: #3a63ff #05071a; }
  .ol-overlay::-webkit-scrollbar, .ol-card::-webkit-scrollbar, .ol-info::-webkit-scrollbar, .ol-setup pre::-webkit-scrollbar { width: 5px; height: 5px; }
  .ol-overlay::-webkit-scrollbar-track, .ol-card::-webkit-scrollbar-track, .ol-info::-webkit-scrollbar-track, .ol-setup pre::-webkit-scrollbar-track { background: #05071a; }
  .ol-overlay::-webkit-scrollbar-thumb, .ol-card::-webkit-scrollbar-thumb, .ol-info::-webkit-scrollbar-thumb, .ol-setup pre::-webkit-scrollbar-thumb { background: linear-gradient(#b8601c, #7a3410); border: 1px solid #f0b030; border-radius: 0; }
  .ol-overlay::-webkit-scrollbar-thumb:hover, .ol-card::-webkit-scrollbar-thumb:hover { background: linear-gradient(#e08a30, #a85414); }
  .ol-overlay::-webkit-scrollbar-corner { background: #05071a; }

  /* phones and tablets: no double-tap zoom on the panels, inputs big enough that iOS does not zoom the page, bigger targets */
  .ol-overlay { touch-action: pan-y; -webkit-tap-highlight-color: transparent; overscroll-behavior: contain; }
  @media (pointer: coarse) {
    .ol-field input { font-size: 16px; padding: 0.7rem; }
    .ol-btn { min-height: 44px; }
    .ol-btn.small { min-height: 38px; min-width: 38px; }
    .ol-char { min-height: 76px; }
    .ol-var { min-width: 52px; min-height: 52px; }
    .ol-item { min-height: 52px; }
    .ol-kick { padding: 0.5rem 0.7rem; font-size: 12px; }
    .ol-switch input { width: 22px; height: 22px; }
  }
</style>
