---
import SvnzGameView from '../components/SvnzGame.tsx';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Super Vampire Ninja Zero</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <SvnzGameView client:only="react" />
  </body>
</html>

<style is:global>
  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; overscroll-behavior: none; }
  .sv-stage { position: fixed; inset: 0; height: 100vh; height: 100dvh; background: #000; }
  .sv-stage:fullscreen { width: 100vw; height: 100vh; }
  .sv-canvas { display: block; width: 100%; height: 100%; outline: none; touch-action: none; }
  .sv-rotate { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.92); color: #f0e0e0; z-index: 10; text-align: center; }
  .sv-rotate-inner { font: bold 1.4rem/1.5 system-ui, sans-serif; display: flex; flex-direction: column; gap: 1rem; }
  .sv-rotate-icon { font-size: 3rem; animation: sv-spin 2s ease-in-out infinite; }
  @keyframes sv-spin { 0%, 20% { transform: rotate(0deg); } 70%, 100% { transform: rotate(90deg); } }

  /* --- touch controls: everything scales with the screen height so phones of any size keep a playable layout ---
     --b = diameter of an action button; --g = gap; --m = margin to the screen edge (notch aware) */
  .sv-touch { --b: clamp(2.9rem, 17vh, 4.6rem); --g: clamp(0.35rem, 2vh, 0.7rem); --m: clamp(0.5rem, 3vh, 1.2rem);
    position: fixed; inset: 0; z-index: 5; touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent; }
  .sv-stick-ring, .sv-stick-knob { position: absolute; border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; }
  .sv-stick-ring { width: calc(var(--b) * 2.2); height: calc(var(--b) * 2.2); border: 2px solid rgba(255,255,255,0.45); background: rgba(255,255,255,0.08); }
  .sv-stick-knob { width: calc(var(--b) * 1.05); height: calc(var(--b) * 1.05); background: rgba(255,255,255,0.35); border: 2px solid rgba(255,255,255,0.7); }
  .sv-stick-hint { position: absolute; pointer-events: none; border-radius: 50%; left: calc(var(--m) + env(safe-area-inset-left)); bottom: calc(var(--m) + env(safe-area-inset-bottom));
    width: calc(var(--b) * 2.1); height: calc(var(--b) * 2.1); display: flex; align-items: center; justify-content: center; border: 2px dashed rgba(255,255,255,0.22); color: rgba(255,255,255,0.4); font: bold 2rem system-ui; }
  .sv-act { position: absolute; pointer-events: none; border-radius: 50%; width: var(--b); height: var(--b); display: flex; flex-direction: column; align-items: center; justify-content: center;
    border: 2px solid rgba(255,255,255,0.55); background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.95); text-shadow: 0 1px 2px rgba(0,0,0,0.8); transition: transform 60ms, background 60ms; }
  .sv-act.is-down { background: rgba(255,255,255,0.4); transform: scale(0.93); }
  .sv-act-k { font: bold clamp(0.8rem, 3.6vh, 1.1rem) system-ui, sans-serif; line-height: 1; }
  .sv-act-s { font: 600 clamp(0.42rem, 1.7vh, 0.58rem) system-ui, sans-serif; opacity: 0.85; }
  /* right cluster, keyboard shape: bottom row Q W E, upper row A S D */
  .sv-b-fast, .sv-b-special { right: calc(var(--m) + (var(--b) + var(--g)) * 2 + env(safe-area-inset-right)); }
  .sv-b-strong, .sv-b-defense { right: calc(var(--m) + (var(--b) + var(--g)) + env(safe-area-inset-right)); }
  .sv-b-jump, .sv-b-dash { right: calc(var(--m) + env(safe-area-inset-right)); }
  .sv-b-fast, .sv-b-strong, .sv-b-jump { bottom: calc(var(--m) + env(safe-area-inset-bottom)); }
  .sv-b-special, .sv-b-defense, .sv-b-dash { bottom: calc(var(--m) + var(--b) + var(--g) + env(safe-area-inset-bottom)); }
  .sv-b-fast { border-color: rgba(255,210,120,0.8); } .sv-b-strong { border-color: rgba(255,120,120,0.8); } .sv-b-jump { border-color: rgba(140,220,255,0.8); }
  .sv-b-special { border-color: rgba(220,140,255,0.8); } .sv-b-defense { border-color: rgba(160,255,160,0.8); } .sv-b-dash { border-color: rgba(255,255,160,0.8); }
  /* always-visible buttons: back and help top right, fullscreen top left */
  .sv-top-btn { position: fixed; z-index: 8; top: calc(0.5rem + env(safe-area-inset-top)); right: calc(0.6rem + env(safe-area-inset-right)); width: clamp(2.4rem, 10vh, 3rem); height: clamp(2.4rem, 10vh, 3rem); border-radius: 50%;
    display: flex; align-items: center; justify-content: center; border: 2px solid rgba(255,255,255,0.6); background: rgba(0,0,0,0.35); color: #fff; font: bold 1.1rem system-ui; padding: 0;
    touch-action: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .sv-top-btn:active { background: rgba(255,255,255,0.3); transform: scale(0.94); }
  .sv-help-btn { right: calc(0.6rem + clamp(2.4rem, 10vh, 3rem) + 0.5rem + env(safe-area-inset-right)); }
  .sv-full-btn { left: calc(0.6rem + env(safe-area-inset-left)); right: auto; }

  /* --- VS y Online panels (lobby, character select, local co-op) --- */
  .ol-overlay { position: fixed; inset: 0; z-index: 30; display: flex; justify-content: center; padding: 0.6rem; background: rgba(8, 4, 16, 0.86); overflow: auto; color: #f3e9ff;
    font: 400 0.85rem/1.45 system-ui, sans-serif; }
  .ol-card { width: min(60rem, 100%); height: fit-content; margin: auto; background: linear-gradient(#1d1230, #120a22); border: 3px solid #7a4cc2; border-radius: 0.6rem; padding: 1rem 1.2rem; box-shadow: 0 0 0 3px #000, 0 12px 40px rgba(0,0,0,0.7); }
  .ol-card.narrow { width: min(26rem, 100%); }
  .ol-card h1 { margin: 0 0 0.4rem; font: 400 1.05rem/1.4 'Press Start 2P', monospace; color: #ffd84a; text-shadow: 2px 2px 0 #000; }
  .ol-card h2 { font: 400 0.8rem 'Press Start 2P', monospace; color: #ffd84a; }
  .ol-sub { margin: 0.2rem 0 0.8rem; color: #cdbbe8; }
  .ol-label { font: 400 0.65rem 'Press Start 2P', monospace; margin-bottom: 0.4rem; }
  .ol-two { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .ol-chars { display: grid; grid-template-columns: repeat(auto-fill, minmax(5.4rem, 1fr)); gap: 0.4rem; }
  .ol-char { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; padding: 0.3rem 0.2rem; background: #231638; border: 2px solid #3d2a63; border-radius: 0.4rem; color: #e9dcff; cursor: pointer; font: 400 0.6rem 'Press Start 2P', monospace; }
  .ol-char:hover, .ol-char:focus-visible { border-color: #b48cff; outline: none; }
  .ol-char.on { border-color: #ffd84a; background: #3a2760; }
  .ol-portrait { image-rendering: pixelated; display: block; }
  .ol-info { margin-top: 0.5rem; min-height: 5.6rem; font-size: 0.8rem; color: #d8c8f0; }
  .ol-info ul { margin: 0.3rem 0 0; padding-left: 1.1rem; }
  .ol-keys { margin: 0.8rem 0; padding: 0.5rem 0.7rem; background: #0d0718; border-radius: 0.4rem; font-size: 0.78rem; display: grid; gap: 0.25rem; }
  .ol-actions { display: flex; gap: 0.6rem; justify-content: flex-end; margin-top: 0.9rem; flex-wrap: wrap; }
  .ol-btn { padding: 0.55rem 1rem; background: #2a1a47; color: #f3e9ff; border: 2px solid #6b46b8; border-radius: 0.4rem; font: 400 0.7rem 'Press Start 2P', monospace; cursor: pointer; }
  .ol-btn:hover:not(:disabled), .ol-btn:focus-visible { border-color: #ffd84a; outline: none; }
  .ol-btn.primary { background: #c2321f; border-color: #ff7a5a; }
  .ol-btn.primary.on { background: #2a9d4a; border-color: #7dffa0; }
  .ol-btn.on { background: #ffd84a; color: #1a1030; border-color: #fff2a8; }
  .ol-btn.small { padding: 0.35rem 0.6rem; font-size: 0.6rem; }
  .ol-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .ol-field { display: block; margin: 0.6rem 0; font: 400 0.65rem 'Press Start 2P', monospace; color: #ffd84a; }
  .ol-field input { display: block; width: 100%; box-sizing: border-box; margin-top: 0.4rem; padding: 0.55rem 0.7rem; background: #0d0718; color: #fff; border: 2px solid #6b46b8; border-radius: 0.4rem; font: 400 0.95rem system-ui, sans-serif; }
  .ol-field input:focus { outline: none; border-color: #ffd84a; }
  .ol-code-in { font: 400 1.4rem 'Press Start 2P', monospace !important; letter-spacing: 0.3em; text-align: center; text-transform: uppercase; }
  .ol-error { margin: 0.6rem 0; padding: 0.5rem 0.7rem; background: #4a1018; border: 2px solid #ff5a6a; border-radius: 0.4rem; color: #ffd0d4; }
  .ol-result { margin: 0.6rem 0; padding: 0.5rem 0.7rem; background: #12381f; border: 2px solid #5be07a; border-radius: 0.4rem; font: 400 0.7rem 'Press Start 2P', monospace; color: #c9ffd8; }
  .ol-head { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; flex-wrap: wrap; }
  .ol-code { font: 400 2rem 'Press Start 2P', monospace; letter-spacing: 0.25em; color: #fff; background: #0d0718; border: 3px dashed #ffd84a; border-radius: 0.5rem; padding: 0.5rem 0.9rem; display: inline-block; user-select: all; }
  .ol-copy { display: flex; gap: 0.4rem; margin-top: 0.4rem; }
  .ol-meta { text-align: right; display: grid; gap: 0.3rem; font: 400 0.65rem 'Press Start 2P', monospace; color: #cdbbe8; }
  .ol-mode { display: flex; gap: 0.3rem; justify-content: flex-end; }
  .ol-slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(9.2rem, 1fr)); gap: 0.5rem; margin: 0.8rem 0; }
  .ol-slot { display: flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.5rem; background: #1c1030; border: 3px solid #3d2a63; border-radius: 0.5rem; min-height: 4.6rem; }
  .ol-slot.me { background: #2a1850; }
  .ol-slot.empty { min-height: 3.2rem; justify-content: center; color: #7d6a9c; border-style: dashed; font-size: 0.8rem; }
  .ol-slot-t { display: grid; gap: 0.1rem; flex: 1; min-width: 0; }
  .ol-slot-t b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ol-slot-t span { font-size: 0.75rem; color: #cdbbe8; }
  .ol-team.t1 { color: #ff8a8a !important; } .ol-team.t2 { color: #8ab8ff !important; }
  .ol-ok { position: absolute; right: 6px; bottom: 4px; font: 400 0.55rem 'Press Start 2P', monospace; color: #7d6a9c; } .ol-ok.on { color: #5be07a; }
  .ol-teams { display: flex; gap: 0.4rem; align-items: center; margin-top: 0.6rem; font: 400 0.65rem 'Press Start 2P', monospace; }
  .ol-diff { margin-top: 0.7rem; padding: 0.4rem 0.6rem; background: #0d0718; border-radius: 0.4rem; font-size: 0.78rem; color: #cdbbe8; }
  .ol-setup pre { background: #0d0718; padding: 0.7rem; border-radius: 0.4rem; overflow: auto; font-size: 0.78rem; }
  .ol-setup code { color: #ffd84a; }
  @media (max-width: 40rem) { .ol-two { grid-template-columns: 1fr; } .ol-card { padding: 0.8rem; } .ol-code { font-size: 1.4rem; } }

  .ol-ico { display: inline-block; background-image: url('/assets/bonus/powerups.png'); image-rendering: pixelated; background-repeat: no-repeat; flex: none; }
  .ol-settings { margin-top: 0.8rem; padding: 0.6rem 0.7rem; background: #0d0718; border-radius: 0.5rem; }
  .ol-switch { display: flex; align-items: center; gap: 0.5rem; margin: 0.2rem 0 0.6rem; cursor: pointer; }
  .ol-switch input { width: 1.1rem; height: 1.1rem; accent-color: #ffd84a; }
  .ol-items { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0.4rem; }
  .ol-items.off { opacity: 0.45; }
  .ol-item { display: grid; grid-template-columns: auto 1fr; grid-template-areas: 'i n' 'i b'; gap: 0 0.5rem; align-items: center; text-align: left; padding: 0.35rem 0.5rem; background: #1c1030; border: 2px solid #3d2a63; border-radius: 0.4rem; color: #e9dcff; cursor: pointer; font: 400 0.75rem system-ui, sans-serif; opacity: 0.55; }
  .ol-item .ol-ico { grid-area: i; } .ol-item b { grid-area: n; font-size: 0.8rem; } .ol-item small { grid-area: b; color: #cdbbe8; line-height: 1.25; }
  .ol-item.on { opacity: 1; border-color: #ffd84a; background: #2c1a50; }
  .ol-item:disabled { cursor: default; }
  .ol-slot.off { opacity: 0.6; }
  .ol-lost { color: #ffb84a !important; }
  .ol-kick { position: absolute; top: 2px; right: 4px; background: none; border: 0; color: #ff8a8a; font: 700 0.8rem system-ui; cursor: pointer; padding: 0.15rem 0.3rem; }
  .ol-slot { position: relative; }
</style>
