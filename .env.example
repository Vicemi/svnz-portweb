# Online modes (VS y Online). Both are set where the site is built (Cloudflare Pages: Settings > Variables and secrets).
# Leave them empty and the online modes show a "backend not configured" panel; local co-op keeps working.

# Address of your svnz-backend (https, no trailing slash). Example: https://svnz-api.example.com
PUBLIC_SVNZ_BACKEND_URL=
# The GAME_TOKEN of the backend's .env (this is a game key, not a password: it ends up inside the page).
PUBLIC_SVNZ_BACKEND_TOKEN=
